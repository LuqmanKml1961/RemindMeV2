# Web Push (VAPID). Generate your own with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Push-scheduling backend storage (subscriptions + trigger times only — never reminder content).
# Local dev: leave unset to use a local SQLite file (local.db).
# Production: point at a Turso/libSQL database. If you provision Turso through Vercel's storage
# marketplace, it may name these DATABASE_TURSO_DATABASE_URL / DATABASE_TURSO_AUTH_TOKEN instead —
# lib/push/store.ts checks both, so either naming works.
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# Optional: protects /api/push/dispatch when called by a cron provider.
CRON_SECRET=
